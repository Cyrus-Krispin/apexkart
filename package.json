{
  "name": "apexkart",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run version:check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tracks": "node --experimental-strip-types scripts/fetch-tracks.ts",
    "world": "node --experimental-strip-types scripts/build-world.ts",
    "venues": "node --experimental-strip-types scripts/build-venues.ts",
    "release": "node --experimental-strip-types scripts/release.ts",
    "version:check": "node --experimental-strip-types scripts/release.ts --check"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "leaflet": "^1.9.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
